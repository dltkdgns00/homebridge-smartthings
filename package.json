{
  "private": false,
  "displayName": "SmartThings Plugin",
  "name": "homebridge-smartthings-sl",
  "version": "1.6.1",
  "description": "Connects SmartThings devices to Homebridge. Automatically discovers devices.",
  "author": "SangHoon Lee (https://github.com/dltkdgns00)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dltkdgns00/homebridge-smartthings.git"
  },
  "bugs": {
    "url": "https://github.com/dltkdgns00/homebridge-smartthings/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "deploy": "./scripts/deploy.sh",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "homebridge": "^1.8.5",
    "nodemon": "^3.1.9",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
